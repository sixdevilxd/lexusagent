# ================= Telegram =================
# Get from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
# Leave empty to allow everyone (NOT recommended for a trading bot).
ALLOWED_USER_IDS=

# ================= AI brain (Claude Code CLI) =================
# Command that invokes Claude Code in your Termux/Debian env
CLAUDE_CMD=claude
# Args passed before the prompt. -p = print/headless mode.
CLAUDE_ARGS=-p

# ================= Chain / RPC =================
# Supported: mainnet, sepolia, base, base-sepolia, arbitrum, optimism, polygon
# Default = base-sepolia (testnet). Only switch to mainnet when you know what you're doing.
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org

# ================= ZeroDev (https://dashboard.zerodev.app) =================
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=

# ================= Security =================
# Master password used to encrypt wallet private keys at rest (AES-256-GCM).
# Use a long random string. NEVER commit this.
WALLET_ENCRYPTION_KEY=

# ================= Trading =================
# Uniswap V3 SwapRouter02 address for the selected chain
DEX_ROUTER=
# Wrapped native token (WETH) address for the selected chain
WETH_ADDRESS=
# Default slippage in basis points (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100
