# ================= Telegram =================
# Get from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
# Leave empty to allow everyone (NOT recommended for a trading bot).
ALLOWED_USER_IDS=

# ================= AI provider =================
# claude             -> local Claude Code CLI
# agentrouter        -> AgentRouter, OpenAI-compatible  (gpt-5.5 / glm-5.2)
# agentrouter-claude -> AgentRouter, Anthropic protocol (claude-opus-4-6)
AI_PROVIDER=claude

# --- Option A: Claude Code CLI ---
CLAUDE_CMD=claude
CLAUDE_ARGS=-p
# TIP: you can point Claude Code itself at AgentRouter by exporting:
#   ANTHROPIC_AUTH_TOKEN=<your AgentRouter key>
#   ANTHROPIC_BASE_URL=https://agentrouter.org
#   ANTHROPIC_MODEL=claude-opus-4-6

# --- Option B/C: AgentRouter ---
# API key from https://agentrouter.org/console/token
AGENTROUTER_API_KEY=
# OpenAI-compatible model (AI_PROVIDER=agentrouter): gpt-5.5 | glm-5.2
AGENTROUTER_MODEL=gpt-5.5
# Anthropic model (AI_PROVIDER=agentrouter-claude): claude-opus-4-6 | claude-opus-4-7 | claude-opus-4-8
AGENTROUTER_CLAUDE_MODEL=claude-opus-4-6
AGENTROUTER_MAX_TOKENS=4096
# NOTE: Base URLs are FIXED in code:
#   OpenAI-compatible  -> https://agentrouter.org/v1
#   Anthropic-compatible -> https://agentrouter.org   (no /v1)

# ================= Chain / RPC =================
# Supported: mainnet, sepolia, base, base-sepolia, arbitrum, optimism, polygon
# Default = base-sepolia (testnet). Only switch to mainnet when you know what you're doing.
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org

# ================= ZeroDev (https://dashboard.zerodev.app) =================
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=

# ================= Security =================
# Master password used to encrypt wallet private keys at rest (AES-256-GCM).
# Use a long random string. NEVER commit this.
WALLET_ENCRYPTION_KEY=

# ================= Trading =================
# Uniswap V3 SwapRouter02 address for the selected chain
DEX_ROUTER=
# Wrapped native token (WETH) address for the selected chain
WETH_ADDRESS=
# Default slippage in basis points (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# ================= Token Mint / Launchpad =================
# Address of the token-factory / launchpad contract used by /mint
# (edit the ABI in src/mint/launchpad.ts to match your launchpad's create function)
TOKEN_FACTORY_ADDRESS=
# Optional creation fee (in native coin) sent with the mint tx, e.g. 0.001
MINT_CREATION_FEE_ETH=
