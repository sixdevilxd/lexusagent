# ================= Telegram =================
# Get from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
# Leave empty to allow everyone (NOT recommended — this bot has wallet + GitHub access).
ALLOWED_USER_IDS=

# ================= AI provider =================
# agentrouter-claude -> AgentRouter, Anthropic protocol (claude-opus-5)  [default]
# agentrouter        -> AgentRouter, OpenAI-compatible  (gpt-5.5 / glm-5.2)
# claude             -> local Claude Code CLI
AI_PROVIDER=agentrouter-claude

# API key from https://agentrouter.org/console/token
AGENTROUTER_API_KEY=
AGENTROUTER_CLAUDE_MODEL=claude-opus-5
AGENTROUTER_MODEL=gpt-5.5
AGENTROUTER_MAX_TOKENS=8192
# Base URL is fixed in code to exactly: https://agentrouter.org

# --- Only used when AI_PROVIDER=claude ---
CLAUDE_CMD=claude
CLAUDE_ARGS=-p
# TIP: point Claude Code at AgentRouter by exporting:
#   ANTHROPIC_AUTH_TOKEN=<your AgentRouter key>
#   ANTHROPIC_BASE_URL=https://agentrouter.org
#   ANTHROPIC_MODEL=claude-opus-5

# ================= GitHub OAuth (Device Flow) =================
# Create an OAuth App at https://github.com/settings/developers
# and tick "Enable Device Flow". See GITHUB.md for the full walkthrough.
# No client secret is needed for device flow.
GITHUB_CLIENT_ID=
# Optional — leave empty for full access scopes.
GITHUB_SCOPES=

# ================= Chain / RPC =================
# Supported: mainnet, sepolia, base, base-sepolia, arbitrum, optimism, polygon
CHAIN=base-sepolia
RPC_URL=https://sepolia.base.org

# ================= ZeroDev (https://dashboard.zerodev.app) =================
# API v3: ONE RPC URL serves BOTH the bundler and the paymaster.
# Format: https://rpc.zerodev.app/api/v3/<PROJECT_ID>/chain/<CHAIN_ID>
# Chain IDs: base-sepolia=84532, base=8453, sepolia=11155111, mainnet=1,
#            arbitrum=42161, optimism=10, polygon=137
# Remember to enable a Gas Policy in the dashboard, or sponsorship will fail.
ZERODEV_RPC=
ZERODEV_PROJECT_ID=
# Advanced (optional) — leave empty to use ZERODEV_RPC for both:
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=

# ================= Security =================
# Encrypts wallet private keys AND GitHub tokens at rest (AES-256-GCM).
# Use a long random string. NEVER commit this. Back it up.
WALLET_ENCRYPTION_KEY=

# ================= Trading =================
DEX_ROUTER=
WETH_ADDRESS=
DEFAULT_SLIPPAGE_BPS=100

# ================= Token Mint / Launchpad =================
# (edit the ABI in src/mint/launchpad.ts to match your launchpad's create function)
TOKEN_FACTORY_ADDRESS=
MINT_CREATION_FEE_ETH=
