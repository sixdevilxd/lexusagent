# ================= Telegram =================
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_USER_IDS=

# ================= AI — AgentRouter =================
# The AI always runs on your AgentRouter API key.
# Get one at https://agentrouter.org/console/token
AGENTROUTER_API_KEY=

# agentrouter-claude -> Anthropic protocol, claude-opus-5      [default]
# agentrouter        -> OpenAI-compatible, gpt-5.5 / glm-5.2
AI_PROVIDER=agentrouter-claude

AGENTROUTER_CLAUDE_MODEL=claude-opus-5
AGENTROUTER_MODEL=gpt-5.5
AGENTROUTER_MAX_TOKENS=8192
# Base URL is fixed in code to exactly: https://agentrouter.org

# ================= GitHub OAuth (Device Flow) =================
# Create an OAuth App at https://github.com/settings/developers
# and tick "Enable Device Flow". See GITHUB.md. No client secret needed.
GITHUB_CLIENT_ID=
GITHUB_SCOPES=

# ================= Chain =================
# ZeroDev is ERC-4337, so ONLY EVM chains are supported (no Solana/Sui/Aptos).
#
# Accepts: a viem chain name, a friendly alias, or a raw chain id.
#
#   Testnets (recommended while testing):
#     base-sepolia (84532) | sepolia (11155111) | arbitrum-sepolia (421614)
#     optimism-sepolia (11155420) | polygon-amoy (80002) | avalanche-fuji (43113)
#     monad-testnet (10143) | blast-sepolia | scroll-sepolia | linea-sepolia
#
#   Mainnets (real money — only when you're ready):
#     mainnet (1) | base (8453) | arbitrum (42161) | optimism (10)
#     polygon (137) | bsc (56) | avalanche (43114) | linea (59144)
#     scroll (534352) | mantle (5000) | blast (81457) | celo (42220)
#     gnosis (100) | mode (34443) | berachain (80094) | unichain (130)
#     sonic (146) | ink (57073) | opbnb (204) | degen | cyber | aurora
#
# Full ZeroDev list: https://docs.zerodev.app/api-and-toolings/faqs/chains
CHAIN=base-sepolia

# Optional — leave empty to use the chain's public RPC.
# Set your own (Alchemy/Infura/QuickNode) for production reliability.
RPC_URL=

# ================= ZeroDev (https://dashboard.zerodev.app) =================
# Just set the project id — the RPC URL is built automatically as:
#   https://rpc.zerodev.app/api/v3/<PROJECT_ID>/chain/<CHAIN_ID>
# so it can never mismatch the CHAIN above.
# Remember to enable a Gas Policy in the dashboard, or sponsorship will fail.
ZERODEV_PROJECT_ID=
# Optional override (wins over the auto-built URL):
ZERODEV_RPC=
# Advanced — only if you use a different AA infra provider:
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=

# ================= Security =================
# Encrypts wallet private keys AND GitHub tokens at rest (AES-256-GCM).
# Use a long random string. NEVER commit this. Back it up.
WALLET_ENCRYPTION_KEY=

# ================= Trading =================
# Uniswap V3 SwapRouter02 + WETH for the chain you selected.
DEX_ROUTER=
WETH_ADDRESS=
DEFAULT_SLIPPAGE_BPS=100

# ================= Token Mint / Launchpad =================
# (edit the ABI in src/mint/launchpad.ts to match your launchpad's create function)
TOKEN_FACTORY_ADDRESS=
MINT_CREATION_FEE_ETH=
